APP_MODE=local
DATABASE_URL=postgresql://dealership_runtime:replace-local-password@127.0.0.1:5432/dealership
MIGRATION_DATABASE_URL=postgresql://postgres:replace-local-password@127.0.0.1:5432/dealership
PROTECTION_NAMESPACE=dealership-local
PROTECTION_ID_KEY=replace-with-a-generated-secret-at-least-32-bytes
READINESS_KEY=replace-with-a-separate-generated-secret-at-least-32-bytes
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=dealership
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_HTTP_URL=http://127.0.0.1:8025
# Tests create/drop only randomly named databases in the isolated local/CI cluster.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:replace-local-password@127.0.0.1:5432/postgres
